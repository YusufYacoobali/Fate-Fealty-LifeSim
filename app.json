{
  "expo": {
    "name": "Fate & Fealty",
    "slug": "medieval-life-simulator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon-ios.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "scheme": "fateandfealty",
    "splash": {
      "backgroundColor": "#0d1b2e",
