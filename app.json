{
  "expo": {
    "name": "Fate & Fealty",
    "slug": "medieval-life-simulator",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon-ios.png",
    "experiments": {
      "reactCompiler": true
    },
    "userInterfaceStyle": "light",
    "scheme": "fateandfealty",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yacoobali.med",
      "appStoreUrl": "https://apps.apple.com/app/id6786423727",
      "icon": "./assets/icon/icon-ios.png",
      "infoPlist": {
        "UIStatusBarHidden": true
      }
    },
    "android": {
      "package": "com.yacoobali.med",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.yacoobali.med",
      "icon": "./assets/icon/icon_android.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/icon_android.png",
        "backgroundColor": "#0d1b2e"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1b2e"
        }
      ],
      "expo-asset",
      "expo-notifications",
      "expo-audio",
      [
        "expo-status-bar",
        {
          "hidden": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "bb28a220-3a1e-4c84-8e16-7525b1117aed"
      },
      "revenueCat": {
        "androidApiKey": "goog_UnkuUkiZMGCHufeOyUZDfYsJFlQ",
        "iosApiKey": "appl_ujLMhXfUBPBOEqEmAjKZYZYKYOp"
      }
    }
  }
}
