# The project's public Meta configuration is in .env.
# Use .env.local or EAS environment values only when overriding that app.
# Public SDK identifiers from Meta for Developers > App Settings.
# Never add the Meta App Secret or CAPI access token to the mobile app.
META_APP_ID=
META_CLIENT_TOKEN=
# Published app terms for Android; iOS defaults to Apple's standard EULA.
TERMS_OF_USE_URL=
